# MongoDB Connection String

MONGODB_URI=mongodb://localhost:27017/stockpilot?replicaSet=rs0
# JWT Secrets for Authentication
# Generate secure secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=your_access_token
JWT_REFRESH_SECRET=your_refresh_token
# App Base URL (Dynamic domain for OpenGraph, Twitter cards & SEO)

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true only when a trusted reverse proxy strips and overwrites these headers.
# Direct Docker/LAN access should leave this unset.
TRUST_PROXY_HEADERS=false

# Refresh-token lifetime in days (1–180, default 30).
SESSION_REFRESH_DAYS=30
