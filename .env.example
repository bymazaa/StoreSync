# MongoDB Connection String

# For local development (MongoDB running on localhost)
MONGODB_URI=mongodb://localhost:27017/stockpilot?replicaSet=rs0

# JWT Secrets for Authentication
# Generate secure secrets: openssl rand -base64 48
JWT_ACCESS_SECRET=avQm2xL9pR5kT8wN4yH6cF1zB4aD0lE7uJ9iK2mL
JWT_REFRESH_SECRET=eA8nZ3rW6pY1tK9vC4xH7qP2dF5sB0eU8kG6iR4

# How many days a signed-in device stays logged in before the password is needed again (1-180, default 30)
SESSION_REFRESH_DAYS=30

# Headless Chromium that writes statement PDFs (Reports -> Statement PDF). Leave unset to disable the
# download; the Reports page then offers the browser's print dialog instead.
# Local: docker compose -f docker-compose-dev.yml up -d pdf-browser
# Production: the pdf-browser service in docker-compose.yml sets this for the app container already.
PDF_BROWSER_WS=http://127.0.0.1:9222
